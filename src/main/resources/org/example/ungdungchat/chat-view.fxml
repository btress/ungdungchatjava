<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.ungdungchat.ChatController"
            prefWidth="920" prefHeight="640"
            stylesheets="@style.css">

    <!-- ===== Thanh tiêu đề ===== -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="thanh-tieu-de">
            <padding>
                <Insets top="14" right="18" bottom="14" left="18"/>
            </padding>
            <Label fx:id="lblTieuDe" text="Phòng chat chung" styleClass="tieu-de-phong"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTen" text="Bạn:" styleClass="ten-toi"/>
        </HBox>
    </top>

    <!-- ===== Khung tin nhắn ===== -->
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" styleClass="vung-chat">
            <content>
                <VBox fx:id="khungTinNhan" spacing="8">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- ===== Danh sách người online ===== -->
    <right>
        <VBox spacing="6" prefWidth="190" styleClass="cot-phai">
            <padding>
                <Insets top="12" right="10" bottom="12" left="10"/>
            </padding>
            <Label text="Đang online" styleClass="nhan-cot"/>
            <ListView fx:id="danhSachOnline" VBox.vgrow="ALWAYS"/>
        </VBox>
    </right>

    <!-- ===== Thanh nhập tin nhắn ===== -->
    <bottom>
        <HBox spacing="8" alignment="CENTER" styleClass="thanh-nhap">
            <padding>
                <Insets top="10" right="14" bottom="12" left="14"/>
            </padding>
            <Button text="📎  Gửi file" onAction="#onGuiFile"
                    prefHeight="38" styleClass="nut-phu"/>
            <TextField fx:id="oNhap" promptText="Nhập tin nhắn..."
                       onAction="#onGuiTinNhan" prefHeight="38"
                       HBox.hgrow="ALWAYS" styleClass="o-tin-nhan"/>
            <Button text="Gửi" onAction="#onGuiTinNhan"
                    prefWidth="76" prefHeight="38" styleClass="nut-gui"/>
        </HBox>
    </bottom>
</BorderPane>